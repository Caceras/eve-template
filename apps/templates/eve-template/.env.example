# Default starter mode. Use a strong value (16+ characters recommended).
EVE_CHAT_USERNAME=
# Required separate random signing secret (32+ random bytes). It also derives the
# key for saved settings: keep it with the data volume.
EVE_SESSION_SECRET=
# Long-term memory directory. Its parent also holds settings/ and chats.sqlite,
# so self-hosted deployments put it directly inside the persistent volume
# (for example /app/.eve/.workflow-data/profile-memory).
EVE_MEMORY_DIR=
EVE_CHAT_PASSWORD=

# Model provider keys. Optional when saved in Settings (saved keys take precedence).
AI_GATEWAY_API_KEY=
OPENROUTER_API_KEY=

# Optional: time zone for scheduled tasks and the agent's clock (default Europe/Stockholm).
AEGENTICA_TIMEZONE=

# Optional: image creation model (default openai/gpt-image-1-mini).
AEGENTICA_IMAGE_MODEL=

# Optional: GitHub token for the GitHub tools when none is saved in Settings → GitHub.
GITHUB_TOKEN=

# Optional: chat history file in password mode (default: chats.sqlite beside the
# memory directory on the persistent volume).
EVE_CHAT_DB_PATH=

# Optional: encrypted settings directory (default: settings/ beside the memory
# directory on the persistent volume).
EVE_SETTINGS_DIR=

# Optional: ports and bind address for `pnpm start` (scripts/start-self-hosted.mjs).
# Next.js listens on NEXT_HOST:PORT (default 0.0.0.0:3000); the eve runtime on
# 127.0.0.1:EVE_NEXT_PRODUCTION_PORT (default 4274).
# PORT=3000
# NEXT_HOST=0.0.0.0
# EVE_NEXT_PRODUCTION_PORT=4274

# Optional production mode. Configure every value in this section to switch
# from SQLite/password auth to Neon, Upstash, and Sign in with Vercel.
DATABASE_URL=
BETTER_AUTH_SECRET=
NEXT_PUBLIC_VERCEL_APP_CLIENT_ID=
VERCEL_APP_CLIENT_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: long-term memory in a private Vercel Blob store (any mode).
# Set by `pnpm exec eve integration setup file-memory`. Memory stays disabled on
# Vercel until one of these is present; generic BLOB_* variables are ignored.
EVE_MEMORY_BLOB_STORE_ID=
EVE_MEMORY_BLOB_READ_WRITE_TOKEN=
EVE_MEMORY_BLOB_WEBHOOK_PUBLIC_KEY=

# Optional: override the app origin for a custom production domain.
BETTER_AUTH_URL=

# Build time only: origin for link previews (Next.js inlines it when building;
# the Docker image defaults to https://aegentica.se). Falls back to BETTER_AUTH_URL
# when unset; an empty value does not fall back.
# NEXT_PUBLIC_SITE_URL=https://aegentica.se

# Optional: enable hosted Vercel Connect integrations.
SLACK_CONNECTOR=
LINEAR_CONNECTOR=
NOTION_CONNECTOR=
SENTRY_CONNECTOR=

# Optional: enables the token-protected custom channel reference route.
EVE_TEMPLATE_DEMO_CHANNEL_TOKEN=
# Optional: 1 adds the reference example tools and the Petstore connection outside development.
# AEGENTICA_EXAMPLES=1
