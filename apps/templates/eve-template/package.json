{
  "name": "eve-template",
  "version": "0.0.0",
  "description": "Ægentica — persistent AI agent product built on the eve framework.",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "next build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:production": "vercel env run -e production -- pnpm db:migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev",
    "start": "node scripts/start-self-hosted.mjs",
    "typecheck": "next typegen && tsgo --noEmit -p tsconfig.json",
    "build:eve": "eve build",
    "dev:eve": "eve dev",
    "start:eve": "eve start",
    "eval": "AEGENTICA_EXAMPLES=1 eve eval",
    "eve:info": "eve info",
    "eve:surface": "node scripts/sync-eve-surface.mjs",
    "eve:surface:check": "node scripts/check-eve-surface.mjs",
    "brands:sync": "node scripts/sync-brand-icons.mjs",
    "upstream:sync": "node scripts/sync-upstream-template.mjs",
    "start:next": "next start",
    "test": "node --test 'scripts/test-!(*-browser).mjs'",
    "check": "pnpm test && pnpm lint && pnpm fmt:check && pnpm typecheck",
    "check:full": "bash scripts/check-product.sh",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "qa:tour": "node scripts/qa-tour.mjs",
    "verify:live": "node scripts/verify-live.mjs"
  },
  "dependencies": {
    "@github-tools/eve-extension": "0.8.0",
    "@neondatabase/serverless": "1.1.0",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@opentelemetry/api": "1.9.1",
    "@radix-ui/react-use-controllable-state": "1.2.2",
    "@streamdown/cjk": "1.0.3",
    "@streamdown/code": "1.1.1",
    "@streamdown/math": "1.0.2",
    "@streamdown/mermaid": "1.0.2",
    "@tailwindcss/postcss": "4.3.3",
    "@upstash/redis": "1.38.2",
    "@vercel/analytics": "2.0.1",
    "@vercel/connect": "0.8.0",
    "@vercel/speed-insights": "2.0.0",
    "ai": "7.0.116",
    "better-auth": "1.7.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "croner": "10.0.1",
    "drizzle-orm": "0.45.3",
    "eve": "0.67.0",
    "just-bash": "3.4.2",
    "katex": "0.16.47",
    "lucide-react": "1.33.0",
    "motion": "12.40.0",
    "nanoid": "5.1.16",
    "next": "16.3.6",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shiki": "3.23.0",
    "streamdown": "2.5.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "use-stick-to-bottom": "1.1.6",
    "web-push": "3.6.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/web-push": "^3.6.4",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "drizzle-kit": "0.31.11",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.4.2"
}
