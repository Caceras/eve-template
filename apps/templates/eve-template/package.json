{
  "name": "eve-template",
  "version": "0.0.0",
  "description": "Ægentica — persistent AI agent product built on the Eve framework.",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "next build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:production": "vercel env run -e production -- pnpm db:migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev",
    "start": "node scripts/start-self-hosted.mjs",
    "typecheck": "next typegen && tsgo --noEmit -p tsconfig.json",
    "build:eve": "eve build",
    "dev:eve": "eve dev",
    "start:eve": "eve start",
    "eval": "eve eval",
    "eve:info": "eve info",
    "eve:surface": "node scripts/sync-eve-surface.mjs",
    "eve:surface:check": "node scripts/check-eve-surface.mjs",
    "start:next": "next start"
  },
  "dependencies": {
